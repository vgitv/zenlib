#!/usr/bin/zsh

setopt localoptions
setopt nounset
setopt pipefail
setopt errreturn

remote="$(git remote -v | tail -n 1 | awk '{ print $2 }')"
if [[ ! $remote =~ https ]]; then
    remote="${remote/git@github.com:/https://github.com/}"
fi
# remove .git extention
remote="${remote%.git}"
$BROWSER "${remote}"
